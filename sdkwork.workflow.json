{
  "$schema": "../sdkwork-github-workflow/schemas/sdkwork-workflow.schema.json",
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-kernel",
    "name": "SDKWork Kernel",
    "repository": "sdkwork-ai/sdkwork-kernel",
    "sourcePath": "."
  },
  "release": {
    "artifactPrefix": "sdkwork-kernel",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "auto",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "sdkwork-ai/sdkwork-drive",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-knowledgebase",
      "repository": "sdkwork-ai/sdkwork-knowledgebase",
      "refInput": "SDKWORK_KNOWLEDGEBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-models",
      "repository": "sdkwork-ai/sdkwork-models",
      "refInput": "SDKWORK_MODELS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sandbox",
      "repository": "sdkwork-ai/sdkwork-sandbox",
      "refInput": "SDKWORK_SANDBOX_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-skills",
      "repository": "sdkwork-ai/sdkwork-skills",
      "refInput": "SDKWORK_SKILLS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.30.2",
    "rust": "stable"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install workspace topology dependency",
        "shell": "pwsh",
        "run": "pnpm install --ignore-scripts"
      }
    ],
    "build": [
      {
        "name": "Run kernel standards and contract verification",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nnode scripts/verify-kernel-audit-remediation.mjs"
      }
    ],
    "package": [
      {
        "name": "Run commercial release gate before packaging",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\npnpm verify:commercial"
      },
      {
        "name": "Build agent server release package",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\ncargo build -p sdkwork-agent-server --release\nnode scripts/release/package-kernel-artifact.mjs"
      }
    ],
    "sign": [
      {
        "name": "Record signing policy for server binaries",
        "shell": "node",
        "run": "const fs=require('node:fs');const path=require('node:path');const packageId=process.env.SDKWORK_PACKAGE_ID;if(!packageId)throw new Error('SDKWORK_PACKAGE_ID is required');const p=path.join('dist','release',packageId,'signing-policy.json');fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,JSON.stringify({packageId,signingRequired:false,reason:'Kernel server packages use checksum+SBOM until org signing keys are provisioned',generatedAt:new Date().toISOString()},null,2)+'\\n');console.log('Signing policy recorded:',p);"
      }
    ],
    "sbom": [
      {
        "name": "Generate CycloneDX SBOM for agent server",
        "shell": "node",
        "run": "node scripts/release/generate-kernel-sbom.mjs"
      }
    ],
    "validate": [
      {
        "name": "Validate release package exists",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\nif (-not $env:SDKWORK_PACKAGE_ID) { throw \"SDKWORK_PACKAGE_ID is required\" }\n$dir = Join-Path (Get-Location) \"dist/release/$env:SDKWORK_PACKAGE_ID\"\nif (-not (Test-Path -LiteralPath $dir)) { throw \"Missing release package directory: $dir\" }"
      },
      {
        "name": "Generate release checksums",
        "shell": "node",
        "run": "node scripts/release/generate-kernel-checksums.mjs"
      },
      {
        "name": "Validate release supply-chain evidence",
        "shell": "node",
        "run": "node scripts/release/validate-release-artifacts.mjs"
      }
    ]
  },
  "targets": [
    {
      "id": "linux-x64-cloud-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "deploymentProfile": "cloud",
      "runtimeTarget": "server",
      "outputGlobs": [
        "dist/release/linux-x64-cloud-server-tar-gz/sdkwork-kernel-linux-x64-cloud-server-tar-gz-*.tar.gz",
        "dist/release/linux-x64-cloud-server-tar-gz/linux-x64-cloud-server-tar-gz-*.cyclonedx.json",
        "dist/release/linux-x64-cloud-server-tar-gz/linux-x64-cloud-server-tar-gz-*.sha256",
        "dist/release/linux-x64-cloud-server-tar-gz/signing-policy.json"
      ]
    },
    {
      "id": "windows-x64-cloud-server-zip",
      "profile": "server",
      "platform": "windows",
      "architecture": "x64",
      "formats": [
        "zip"
      ],
      "runner": "windows-2022",
      "deploymentProfile": "cloud",
      "runtimeTarget": "server",
      "outputGlobs": [
        "dist/release/windows-x64-cloud-server-zip/sdkwork-kernel-windows-x64-cloud-server-zip-*.zip",
        "dist/release/windows-x64-cloud-server-zip/windows-x64-cloud-server-zip-*.cyclonedx.json",
        "dist/release/windows-x64-cloud-server-zip/windows-x64-cloud-server-zip-*.sha256",
        "dist/release/windows-x64-cloud-server-zip/signing-policy.json"
      ]
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": false
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": true,
    "retentionDays": 30
  }
}

# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_ai_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_KERNEL_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_KERNEL_DEPLOYMENT_PROFILE=cloud
SDKWORK_KERNEL_ENVIRONMENT=demo
SDKWORK_KERNEL_PROFILE_ID=cloud.demo
SDKWORK_ENV=demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KERNEL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://kernel-demo.sdkwork.com
# Cloud realtime WebSocket rides the platform api edge — the same base domain
# as the SDK base URL — per the sdkwork-im aligned convention.
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://kernel-demo.sdkwork.com
SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Redis isolation: dedicate a logical DB index so rate-limit/idempotency prefixes never collide.
SDKWORK_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/9

# rig | openclaw | hermes | codex — server runtime plugin (see runtime_bootstrap.rs)
SDKWORK_KERNEL_AGENT_PLUGIN=rig
SDKWORK_CORS_ALLOWED_ORIGINS=https://kernel-demo.sdkwork.com,http://kernel-demo.sdkwork.com,https://kernel-demo.birdcoder.com,http://kernel-demo.birdcoder.com,https://kernel-demo.dtupay.com,http://kernel-demo.dtupay.com,https://kernel-demo.noaper.com,http://kernel-demo.noaper.com,https://kernel-demo.sdkwork.cn,http://kernel-demo.sdkwork.cn,https://kernel-demo.birdcoder.cn,http://kernel-demo.birdcoder.cn,https://kernel-demo.dtupay.cn,http://kernel-demo.dtupay.cn,https://kernel-demo.noaper.cn,http://kernel-demo.noaper.cn,https://kernel-demo.skubc.com,http://kernel-demo.skubc.com,https://kernel-demo.skubc.cn,http://kernel-demo.skubc.cn,https://kernel-demo.zowalk.com,http://kernel-demo.zowalk.com,https://kernel-demo.zowalk.cn,http://kernel-demo.zowalk.cn,https://kernel-demo.offer86.com,http://kernel-demo.offer86.com,https://kernel-demo.offer86.cn,http://kernel-demo.offer86.cn,https://kernel-demo.86offer.com,http://kernel-demo.86offer.com,https://kernel-demo.86offer.cn,http://kernel-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

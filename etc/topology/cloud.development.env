# cloud.development
SDKWORK_KERNEL_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_KERNEL_DEPLOYMENT_PROFILE=cloud
SDKWORK_KERNEL_ENVIRONMENT=development
SDKWORK_KERNEL_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KERNEL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_KERNEL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18280
SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
# Cloud realtime WebSocket rides the platform api edge — the same base domain
# as the SDK base URL — per the sdkwork-im aligned convention (the kernel-*
# application web ingress edge does not terminate WebSocket upgrades). The
# 127.0.0.1:18280 bind above stays a dev-process concern only.
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_KERNEL_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# rig | openclaw | hermes | codex — server runtime plugin (see runtime_bootstrap.rs)
SDKWORK_KERNEL_AGENT_PLUGIN=rig


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://kernel-dev.sdkwork.com,http://kernel-dev.sdkwork.com,https://kernel-dev.birdcoder.com,http://kernel-dev.birdcoder.com,https://kernel-dev.dtupay.com,http://kernel-dev.dtupay.com,https://kernel-dev.noaper.com,http://kernel-dev.noaper.com,https://kernel-dev.sdkwork.cn,http://kernel-dev.sdkwork.cn,https://kernel-dev.birdcoder.cn,http://kernel-dev.birdcoder.cn,https://kernel-dev.dtupay.cn,http://kernel-dev.dtupay.cn,https://kernel-dev.noaper.cn,http://kernel-dev.noaper.cn,https://kernel-dev.skubc.com,http://kernel-dev.skubc.com,https://kernel-dev.skubc.cn,http://kernel-dev.skubc.cn,https://kernel-dev.zowalk.com,http://kernel-dev.zowalk.com,https://kernel-dev.zowalk.cn,http://kernel-dev.zowalk.cn,https://kernel-dev.offer86.com,http://kernel-dev.offer86.com,https://kernel-dev.offer86.cn,http://kernel-dev.offer86.cn,https://kernel-dev.86offer.com,http://kernel-dev.86offer.com,https://kernel-dev.86offer.cn,http://kernel-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_ai_demo`
# and a dedicated Redis logical DB index (see SDKWORK_RATE_LIMIT_REDIS_URL below) so that no cache
# key (rate-limit, idempotency) ever collides with another shared-redis environment.
SDKWORK_KERNEL_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KERNEL_DEPLOYMENT_PROFILE=standalone
SDKWORK_KERNEL_ENVIRONMENT=demo
SDKWORK_KERNEL_PROFILE_ID=standalone.demo
SDKWORK_ENV=demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KERNEL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/port (kept apart from development 18280, so the demo can publish a
# meaningfully distinct origin externally for system demonstrations).
SDKWORK_KERNEL_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18273
SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=http://kernel-demo.sdkwork.com:18273
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://kernel-demo.sdkwork.com:18273
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=http://kernel-demo.sdkwork.com:18273
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://kernel-demo.sdkwork.com:18273

# Demo database isolation: dedicated schema/user `sdkwork_ai_demo` keeps this deployment apart from
# development `sdkwork_ai_dev` on the shared Postgres instance.
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_demo
SDKWORK_DATABASE_USERNAME=sdkwork_ai_demo
SDKWORK_DATABASE_PASSWORD=sdkworkdemo123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# Redis isolation: point the demo at a dedicated logical DB index on the shared Redis so the
# rate-limit/idempotency prefixes remain confined to this environment.
SDKWORK_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/9

# rig | openclaw | hermes | codex — server runtime plugin (see runtime_bootstrap.rs)
SDKWORK_KERNEL_AGENT_PLUGIN=rig
SDKWORK_CORS_ALLOWED_ORIGINS=https://kernel-demo.sdkwork.com,http://kernel-demo.sdkwork.com,https://kernel-demo.birdcoder.com,http://kernel-demo.birdcoder.com,https://kernel-demo.dtupay.com,http://kernel-demo.dtupay.com,https://kernel-demo.noaper.com,http://kernel-demo.noaper.com,https://kernel-demo.sdkwork.cn,http://kernel-demo.sdkwork.cn,https://kernel-demo.birdcoder.cn,http://kernel-demo.birdcoder.cn,https://kernel-demo.dtupay.cn,http://kernel-demo.dtupay.cn,https://kernel-demo.noaper.cn,http://kernel-demo.noaper.cn,https://kernel-demo.skubc.com,http://kernel-demo.skubc.com,https://kernel-demo.skubc.cn,http://kernel-demo.skubc.cn,https://kernel-demo.zowalk.com,http://kernel-demo.zowalk.com,https://kernel-demo.zowalk.cn,http://kernel-demo.zowalk.cn,https://kernel-demo.offer86.com,http://kernel-demo.offer86.com,https://kernel-demo.offer86.cn,http://kernel-demo.offer86.cn,https://kernel-demo.86offer.com,http://kernel-demo.86offer.com,https://kernel-demo.86offer.cn,http://kernel-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

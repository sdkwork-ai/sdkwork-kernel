# standalone.production
SDKWORK_KERNEL_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KERNEL_DEPLOYMENT_PROFILE=standalone
SDKWORK_KERNEL_RUNTIME_TARGET=server
SDKWORK_KERNEL_ENVIRONMENT=production
SDKWORK_KERNEL_PROFILE_ID=standalone.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_KERNEL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_KERNEL_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18280
SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://kernel.example.com
SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://kernel.example.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_HTTP_URL=https://kernel.example.com
VITE_SDKWORK_KERNEL_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://kernel.example.com

SDKWORK_KERNEL_INGRESS_AUTH_MODE=token
SDKWORK_RATE_LIMIT_RPS=100
SDKWORK_RATE_LIMIT_BURST=200
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
# Production dependency URLs are intentionally empty in source control. Inject
# the operator-managed PostgreSQL and Redis URLs from protected host secrets.
SDKWORK_DATABASE_URL=
SDKWORK_RATE_LIMIT_REDIS_URL=
SDKWORK_KERNEL_METRICS_TOKEN=
SDKWORK_CURSOR_SIGNING_SECRET=
SDKWORK_APPROVAL_PAYLOAD_ENCRYPTION_KEY=
SDKWORK_PERMISSION_OPERATION_TTL_SECS=900
SDKWORK_TASK_WORKER_MAX_CONCURRENCY=4
SDKWORK_TASK_WORKER_POLL_INTERVAL_MS=250
SDKWORK_TASK_WORKER_LEASE_SECS=120

# rig | openclaw | hermes | codex — server runtime plugin (see runtime_bootstrap.rs)
SDKWORK_KERNEL_AGENT_PLUGIN=rig

SDKWORK_CORS_ALLOWED_ORIGINS=https://kernel.sdkwork.com,https://kernel.birdcoder.com,https://kernel.dtupay.com,https://kernel.noaper.com,https://kernel.sdkwork.cn,https://kernel.birdcoder.cn,https://kernel.dtupay.cn,https://kernel.noaper.cn,https://kernel.skubc.com,https://kernel.skubc.cn,https://kernel.zowalk.com,https://kernel.zowalk.cn,https://kernel.offer86.com,https://kernel.offer86.cn,https://kernel.86offer.com,https://kernel.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
